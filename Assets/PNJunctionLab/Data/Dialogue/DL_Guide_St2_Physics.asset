  m_Name: DL_Guide_St2_Physics
  m_EditorClassIdentifier: Assembly-CSharp::PNJunctionLab.DialogueLine
  lineId: guide_2_physics
  speakerOverride: 
  text: 'N-Type Doping replaces a Si atom with a Group V Donor (5 valence e-: P, As, Sb). Four electrons form covalent bonds; the 5th ionizes into the Conduction Band from Ed (~0.045 eV below Ec), leaving a fixed orange + donor ion and shifting EF UP!'
