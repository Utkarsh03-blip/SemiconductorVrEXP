  m_Name: DL_Guide_St6_Physics
  m_EditorClassIdentifier: Assembly-CSharp::PNJunctionLab.DialogueLine
  lineId: guide_6_physics
  speakerOverride: 
  text: Every diode follows Shockley's law I = Is*(exp(qVd/nkT) - 1) through the 100 ohm load resistor! Larger bandgap gives higher knee (Ge ~0.3V, Si ~0.7V, LED ~2.0V), heating shifts Vk down (~ -2 mV/C) while growing Is, and Zener diodes break down cleanly at -5.1V.
  emotion: 2
