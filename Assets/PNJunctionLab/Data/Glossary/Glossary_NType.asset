  m_Name: Glossary_NType
  m_EditorClassIdentifier: Assembly-CSharp::PNJunctionLab.GlossaryTopic
  topicId: ntype
  title: N-Type Doping
  summary: Pentavalent Group V donors (P, As, Sb) supply a 5th electron (~0.045 eV below Ec for P in Si). Majority = electrons (n ~ ND), minority = holes (p = ni^2 / n). Stays electrically neutral.
  explanationLine: {fileID: 11400000, guid: 8ab6aa3d210def34197e54e428e05325, type: 2}
