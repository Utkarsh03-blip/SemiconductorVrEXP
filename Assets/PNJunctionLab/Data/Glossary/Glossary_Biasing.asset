  m_Name: Glossary_Biasing
  m_EditorClassIdentifier: Assembly-CSharp::PNJunctionLab.GlossaryTopic
  topicId: biasing
  title: Forward/Reverse Bias
  summary: 'Forward (P to +): barrier drops to V0 - V, depletion narrows, current rises above knee (~0.7 V Si, ~0.3 V Ge, 1.8-3 V LED). Reverse (P to -): barrier rises to V0 + VR, only Is flows until breakdown.'
  explanationLine: {fileID: 11400000, guid: 567629b288808004cb8cc984efad2883, type: 2}
